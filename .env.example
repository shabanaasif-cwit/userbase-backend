PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/userbase
# Browser app URL (CORS + httpOnly refresh cookie). Use your real frontend origin in production.
FRONTEND_ORIGIN=http://localhost:5173

# Auth — use long random strings in production (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
